{
  "name": "lorekeeper",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "pnpm --filter web start",
    "web:start": "pnpm --filter web start",
    "api:start": "dotnet run --project services/api/src/Api/Api.csproj",
    "format": "pnpm --filter web format",
    "format:check": "pnpm --filter web format:check",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test",
    "build": "pnpm --filter web build",
    "e2e": "pnpm --filter web e2e",
    "api:restore": "dotnet restore services/api/Lorekeeper.slnx",
    "api:format:check": "dotnet format services/api/Lorekeeper.slnx --verify-no-changes",
    "api:build": "dotnet build services/api/Lorekeeper.slnx --no-restore --configuration Release",
    "api:test": "dotnet test services/api/Lorekeeper.slnx --no-build --configuration Release",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  }
}
